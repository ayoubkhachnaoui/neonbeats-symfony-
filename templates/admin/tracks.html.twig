{% extends 'base.html.twig' %}

{% block title %}Manage Tracks{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="flex items-center justify-between mb-8">
        <h1 class="text-3xl font-bold text-white">Manage Tracks</h1>
        <a href="{{ path('admin_dashboard') }}" class="text-gray-400 hover:text-white"><i class="fas fa-arrow-left mr-2"></i> Back</a>
    </div>

    <div class="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-gray-400">
                <thead class="bg-gray-800 text-gray-200 uppercase text-xs">
                    <tr>
                        <th class="px-6 py-4">Track</th>
                        <th class="px-6 py-4">Artist</th>
                        <th class="px-6 py-4">Stats</th>
                        <th class="px-6 py-4">Visibility</th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-800">
                    {% for track in tracks %}
                        <tr class="hover:bg-gray-800/50 transition-colors">
                            <td class="px-6 py-4">
                                <div class="flex items-center">
                                    {% if track.coverImage %}
                                        <img src="{{ asset('uploads/images/' ~ track.coverImage) }}" class="w-10 h-10 rounded object-cover mr-3">
                                    {% else %}
                                        <div class="w-10 h-10 rounded bg-gray-700 flex items-center justify-center mr-3"><i class="fas fa-music"></i></div>
                                    {% endif %}
                                    <div>
                                        <p class="font-medium text-white">{{ track.title }}</p>
                                        <p class="text-xs">{{ track.category.name|default('Uncategorized') }}</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                {{ track.artist.artistName }}
                                <p class="text-xs text-gray-500">{{ track.artist.email }}</p>
                            </td>
                            <td class="px-6 py-4">
                                <span class="text-gray-300"><i class="fas fa-play text-xs mr-1"></i> {{ track.playCount }}</span>
                            </td>
                            <td class="px-6 py-4">
                                <form method="post" action="{{ path('admin_track_toggle', {'id': track.id}) }}">
                                    <button class="{{ track.isPublic ? 'text-green-500' : 'text-gray-500' }} hover:underline">
                                        <i class="fas {{ track.isPublic ? 'fa-eye' : 'fa-eye-slash' }} mr-1"></i>
                                        {{ track.isPublic ? 'Public' : 'Hidden' }}
                                    </button>
                                </form>
                            </td>
                            <td class="px-6 py-4 text-right space-x-2">
                                <a href="{{ path('app_track_play', {'id': track.id}) }}" class="text-cyan-500 hover:text-cyan-400" target="_blank">Listen</a>
                                <form method="post" action="{{ path('admin_track_delete', {'id': track.id}) }}" onsubmit="return confirm('Delete this track permanently?');" class="inline-block">
                                    <button class="text-red-500 hover:text-red-400 transition-colors font-medium">Delete</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
