{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-8 text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-orange-500">
        <i class="fas fa-shield-alt mr-2"></i> Admin Control Center
    </h1>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 shadow-[0_0_20px_rgba(239,68,68,0.1)]">
            <h3 class="text-gray-400 text-sm font-medium uppercase tracking-wider mb-2">Total Users</h3>
            <p class="text-4xl font-bold text-white">{{ totalUsers }}</p>
        </div>
        <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 shadow-[0_0_20px_rgba(249,115,22,0.1)]">
            <h3 class="text-gray-400 text-sm font-medium uppercase tracking-wider mb-2">Total Tracks</h3>
            <p class="text-4xl font-bold text-white">{{ totalTracks }}</p>
        </div>
        <div class="bg-gray-900 border border-gray-800 rounded-xl p-6 shadow-[0_0_20px_rgba(236,72,153,0.1)]">
            <h3 class="text-gray-400 text-sm font-medium uppercase tracking-wider mb-2">System Status</h3>
            <p class="text-green-400 font-bold"><i class="fas fa-check-circle mr-2"></i> Operational</p>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {# Quick Actions #}
        <div class="bg-black/40 border border-gray-800 rounded-xl p-6">
            <h2 class="text-xl font-bold mb-4 text-white">Management</h2>
            <div class="space-y-4">
                <a href="{{ path('admin_users') }}" class="block w-full p-4 bg-gray-900 hover:bg-gray-800 rounded-lg border border-gray-700 transition-all group">
                    <div class="flex items-center justify-between">
                        <span class="text-gray-200 font-medium group-hover:text-white"><i class="fas fa-users mr-3 text-cyan-400"></i> Manage Users</span>
                        <i class="fas fa-arrow-right text-gray-500 group-hover:text-white"></i>
                    </div>
                </a>
                <a href="{{ path('admin_tracks') }}" class="block w-full p-4 bg-gray-900 hover:bg-gray-800 rounded-lg border border-gray-700 transition-all group">
                    <div class="flex items-center justify-between">
                        <span class="text-gray-200 font-medium group-hover:text-white"><i class="fas fa-music mr-3 text-fuchsia-400"></i> Manage Tracks</span>
                        <i class="fas fa-arrow-right text-gray-500 group-hover:text-white"></i>
                    </div>
                </a>
            </div>
        </div>

        {# Recent Activity #}
        <div class="bg-black/40 border border-gray-800 rounded-xl p-6">
            <h2 class="text-xl font-bold mb-4 text-white">Recent Signups</h2>
            <ul class="space-y-3">
                {% for user in recentUsers %}
                    <li class="flex items-center justify-between py-2 border-b border-gray-800 last:border-0">
                        <div class="flex items-center">
                            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-cyan-500 to-blue-500 flex items-center justify-center text-xs font-bold text-white mr-3">
                                {{ user.username|slice(0,2)|upper }}
                            </div>
                            <div>
                                <p class="text-sm font-medium text-white">{{ user.username }}</p>
                                <p class="text-xs text-gray-500">{{ user.email }}</p>
                            </div>
                        </div>
                        <span class="text-xs text-gray-500">{{ user.createdAt|date('M d, H:i') }}</span>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
</div>
{% endblock %}
