{% extends 'base.html.twig' %}

{% block title %}Manage Users{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <div class="flex items-center justify-between mb-8">
        <h1 class="text-3xl font-bold text-white">Manage Users</h1>
        <a href="{{ path('admin_dashboard') }}" class="text-gray-400 hover:text-white"><i class="fas fa-arrow-left mr-2"></i> Back</a>
    </div>

    <div class="bg-gray-900 border border-gray-800 rounded-xl overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-gray-400">
                <thead class="bg-gray-800 text-gray-200 uppercase text-xs">
                    <tr>
                        <th class="px-6 py-4">User</th>
                        <th class="px-6 py-4">Role</th>
                        <th class="px-6 py-4">Joined</th>
                        <th class="px-6 py-4">Status</th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-800">
                    {% for user in users %}
                        <tr class="hover:bg-gray-800/50 transition-colors">
                            <td class="px-6 py-4">
                                <div class="flex items-center">
                                    <div class="w-8 h-8 rounded-full bg-gray-700 flex items-center justify-center text-xs font-bold text-white mr-3">
                                        {{ user.username|slice(0,2)|upper }}
                                    </div>
                                    <div>
                                        <p class="font-medium text-white">{{ user.username }}</p>
                                        <p class="text-xs">{{ user.email }}</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-6 py-4">
                                {% if user == app.user %}
                                    {% for role in user.roles %}
                                        <span class="px-2 py-1 bg-gray-700 rounded text-xs text-gray-300 mr-1">{{ role|replace({'ROLE_': ''}) }}</span>
                                    {% endfor %}
                                {% else %}
                                    <form method="post" action="{{ path('admin_user_role', {'id': user.id}) }}" class="flex items-center">
                                        <select name="role" onchange="this.form.submit()" class="bg-gray-800 text-gray-300 text-xs rounded border border-gray-700 focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 py-1 pl-2 pr-6">
                                            <option value="ROLE_USER" {{ 'ROLE_USER' in user.roles and 'ROLE_ARTIST' not in user.roles and 'ROLE_ADMIN' not in user.roles ? 'selected' : '' }}>User</option>
                                            <option value="ROLE_ARTIST" {{ 'ROLE_ARTIST' in user.roles and 'ROLE_ADMIN' not in user.roles ? 'selected' : '' }}>Artist</option>
                                            <option value="ROLE_ADMIN" {{ 'ROLE_ADMIN' in user.roles ? 'selected' : '' }}>Admin</option>
                                        </select>
                                    </form>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4">{{ user.createdAt|date('Y-m-d') }}</td>
                            <td class="px-6 py-4">
                                {% if user.isVerified %}
                                    <span class="text-green-500"><i class="fas fa-check-circle"></i> Verified</span>
                                {% else %}
                                    <span class="text-yellow-500"><i class="fas fa-clock"></i> Pending</span>
                                {% endif %}
                            </td>
                            <td class="px-6 py-4 text-right">
                                {% if 'ROLE_ADMIN' not in user.roles %}
                                    <form method="post" action="{{ path('admin_user_delete', {'id': user.id}) }}" onsubmit="return confirm('Are you sure you want to delete this user?');" class="inline-block">
                                        <button class="text-red-500 hover:text-red-400 transition-colors font-medium">Delete</button>
                                    </form>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
