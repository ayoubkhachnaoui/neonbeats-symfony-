{% extends 'base.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
<div class="flex items-center justify-center min-h-screen relative overflow-hidden">
    {# Background with blur #}
    <div class="absolute inset-0 bg-black/80 z-0"></div>
    
    <div class="w-full max-w-md p-8 space-y-8 bg-gray-900/50 backdrop-blur-md rounded-2xl border border-gray-800 shadow-[0_0_50px_rgba(34,211,238,0.1)] z-10 relative">
        <div class="text-center">
            <h2 class="mt-6 text-3xl font-bold font-['Outfit'] text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">
                Welcome Back
            </h2>
            <p class="mt-2 text-sm text-gray-400">Sign in to your account</p>
        </div>

        <form method="post" class="mt-8 space-y-6" data-turbo="false">
            {% if error %}
                <div class="p-4 mb-4 text-sm text-red-500 rounded-lg bg-red-500/10 border border-red-500/20" role="alert">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            {% if app.user %}
                <div class="mb-3 text-cyan-400">
                    You are logged in as {{ app.user.userIdentifier }}, <a href="{{ path('app_logout') }}">Logout</a>
                </div>
            {% endif %}

            <div class="space-y-4">
                <div>
                    <label for="inputEmail" class="block text-sm font-medium text-gray-300">Email address</label>
                    <input type="email" value="{{ last_username }}" name="_username" id="inputEmail" class="block w-full px-4 py-3 mt-1 text-white bg-black/50 border border-gray-700 rounded-lg focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 placeholder-gray-500 outline-none transition-all" autocomplete="email" required autofocus>
                </div>
                <div>
                    <label for="inputPassword" class="block text-sm font-medium text-gray-300">Password</label>
                    <input type="password" name="_password" id="inputPassword" class="block w-full px-4 py-3 mt-1 text-white bg-black/50 border border-gray-700 rounded-lg focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 placeholder-gray-500 outline-none transition-all" autocomplete="current-password" required>
                </div>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-medium text-black bg-cyan-400 hover:bg-cyan-300 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-cyan-500 transition-all font-bold tracking-wide hover:shadow-[0_0_20px_rgba(34,211,238,0.4)]">
                Sign in
            </button>
            
            <div class="text-center text-sm text-gray-400">
                Don't have an account? <a href="{{ path('app_register') }}" class="font-medium text-cyan-400 hover:text-cyan-300 transition-colors">Sign up</a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
