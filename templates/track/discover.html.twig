{% extends 'base.html.twig' %}

{% block title %}Discover — NeonBeats{% endblock %}

{% block body %}
{# ── Particle Canvas (Search-Reactive) ─────────────────────────────── #}
<canvas id="discover-canvas" class="fixed inset-0 z-0 pointer-events-none"></canvas>

<div class="relative z-10 min-h-screen text-white pb-24">

    {# ── Hero / Search Section ─────────────────────────────────────── #}
    <div class="relative py-16 px-6 overflow-hidden">
        {# Gradient glow behind hero #}
        <div class="absolute inset-0 bg-gradient-to-b from-violet-950/40 via-transparent to-transparent pointer-events-none"></div>

        <div class="relative max-w-7xl mx-auto">
            <p class="text-xs font-semibold tracking-[0.3em] text-cyan-500 uppercase mb-3">Explore</p>
            <h1 class="text-5xl md:text-6xl font-bold font-['Outfit'] mb-8 leading-tight">
                Find Your <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-fuchsia-500 animate-pulse">Vibe</span>
            </h1>

            {# Search & Filters #}
            <div class="flex flex-col md:flex-row gap-3">
                <div class="relative flex-1 group">
                    <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 group-focus-within:text-cyan-400 transition-colors"></i>
                    <input type="text" id="live-search"
                           class="w-full bg-white/[0.05] border border-white/[0.08] rounded-2xl py-4 pl-12 pr-4 text-white placeholder-gray-600 focus:outline-none focus:border-cyan-500/60 focus:bg-white/[0.08] transition-all backdrop-blur-xl text-lg"
                           placeholder="Search tracks, artists, genres..."
                           value="{{ searchQuery|default('') }}">
                    {# Animated underline on focus #}
                    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-0 h-px bg-gradient-to-r from-cyan-500 to-fuchsia-500 group-focus-within:w-full transition-all duration-500 rounded-full"></div>
                </div>

                <select id="genre-filter" class="bg-white/[0.05] border border-white/[0.08] rounded-2xl px-5 py-4 text-white focus:outline-none focus:border-fuchsia-500/60 cursor-pointer backdrop-blur-xl transition-all">
                    <option value="" class="bg-gray-900 text-white">All Genres</option>
                    {% for category in categories %}
                        <option value="{{ category.name }}" class="bg-gray-900 text-white">{{ category.name }}</option>
                    {% endfor %}
                </select>

                <select id="sort-filter" class="bg-white/[0.05] border border-white/[0.08] rounded-2xl px-5 py-4 text-white focus:outline-none focus:border-fuchsia-500/60 cursor-pointer backdrop-blur-xl transition-all">
                    <option value="trending" class="bg-gray-900 text-white">🔥 Trending</option>
                    <option value="newest" class="bg-gray-900 text-white">✨ Newest</option>
                    <option value="az" class="bg-gray-900 text-white">A–Z</option>
                </select>
            </div>
        </div>
    </div>

    <div class="max-w-7xl mx-auto px-6 space-y-14">

        {# ── Quick Playlist Widget (logged in users) ─────────────────── #}
        {% if app.user %}
        <div class="bg-white/[0.03] backdrop-blur-xl border border-white/[0.07] rounded-3xl p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="flex items-center space-x-4">
                <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-cyan-500 to-fuchsia-600 flex items-center justify-center shadow-[0_0_15px_rgba(6,182,212,0.4)]">
                    <i class="fas fa-list-music text-white text-lg"></i>
                </div>
                <div>
                    <p class="font-bold text-white">Your Playlists</p>
                    <p class="text-xs text-gray-500">{{ app.user.playlists|length }} playlist{{ app.user.playlists|length != 1 ? 's' : '' }} · AI-assisted creation</p>
                </div>
            </div>
            <div class="flex items-center space-x-3">
                <a href="{{ path('app_playlist_index') }}"
                   class="px-4 py-2 rounded-full text-sm text-gray-400 border border-white/10 hover:text-white hover:bg-white/10 transition-all">
                    View All
                </a>
                <a href="{{ path('app_playlist_index') }}#create"
                   class="px-4 py-2 rounded-full text-sm font-semibold bg-gradient-to-r from-cyan-500 to-fuchsia-600 text-white hover:opacity-90 hover:shadow-[0_0_20px_rgba(6,182,212,0.4)] transition-all">
                    <i class="fas fa-plus mr-1.5"></i>New Playlist
                </a>
            </div>
        </div>
        {% endif %}

        {# ── All Tracks (Unified) ─────────────────────────────────────── #}
        <section id="all-tracks-section">
            <div class="flex items-center space-x-3 mb-6">
                <div class="w-8 h-8 rounded-xl bg-cyan-500/20 border border-cyan-500/30 flex items-center justify-center">
                    <i class="fas fa-music text-cyan-400 text-sm"></i>
                </div>
                <h2 class="text-2xl font-bold">Discover Tracks</h2>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5" id="track-grid">
                {% for track in allTracks %}
                    {% include 'track/_card.html.twig' with {'track': track} %}
                {% endfor %}
            </div>

            <div id="no-results" class="hidden text-center py-16">
                <div class="w-20 h-20 rounded-full bg-white/5 border border-white/10 flex items-center justify-center mx-auto mb-4">
                    <i class="fas fa-ghost text-3xl text-gray-600"></i>
                </div>
                <p class="text-gray-400 text-lg">No tracks match your vibe.</p>
                <p class="text-gray-600 text-sm mt-1">Try a different search or genre.</p>
            </div>
        </section>
    </div>
</div>

{# ── Floating Quick-Create Playlist Button ─────────────────────────── #}
{% if app.user %}
<a href="{{ path('app_playlist_index') }}"
   class="fixed bottom-8 right-8 z-50 flex items-center space-x-2 px-5 py-3 rounded-full bg-gradient-to-r from-cyan-500 to-fuchsia-600 text-white font-semibold text-sm shadow-[0_0_25px_rgba(6,182,212,0.5)] hover:shadow-[0_0_40px_rgba(6,182,212,0.7)] hover:scale-105 transition-all active:scale-95"
   title="Create Playlist">
    <i class="fas fa-plus"></i>
    <span>New Playlist</span>
</a>
{% endif %}

<script>
    // ── Grid Logic (Scoped) ──────────────────────────────────────────────
    (() => {
        const searchInput = document.getElementById('live-search');
        const genreFilter = document.getElementById('genre-filter');
        const sortFilter  = document.getElementById('sort-filter');
        const trackGrid   = document.getElementById('track-grid');
        const noResults   = document.getElementById('no-results');
        
        if (!trackGrid) return; 

        let tracks = Array.from(document.querySelectorAll('.track-item'));

        function updateGrid() {
            const query    = searchInput?.value.toLowerCase() ?? '';
            const genre    = genreFilter?.value ?? '';
            const sortMode = sortFilter?.value ?? 'trending';

            let visible = tracks.filter(t => {
                const matchSearch = !query || t.dataset.title.includes(query) || t.dataset.artist.includes(query);
                const matchGenre  = !genre || t.dataset.genre === genre;
                return matchSearch && matchGenre;
            });

            visible.sort((a, b) => {
                if (sortMode === 'trending') return (parseInt(b.dataset.plays)||0) - (parseInt(a.dataset.plays)||0);
                if (sortMode === 'newest')   return (parseInt(b.dataset.date)||0)  - (parseInt(a.dataset.date)||0);
                if (sortMode === 'az')       return (a.dataset.title||'').localeCompare(b.dataset.title||'');
                return 0;
            });

            tracks.forEach(t => t.style.display = 'none');
            visible.forEach(t => { t.style.display = 'flex'; trackGrid.appendChild(t); });
            noResults?.classList.toggle('hidden', visible.length > 0);

            // Pulse canvas on search
            if (query && window.pulseDiscoverCanvas) window.pulseDiscoverCanvas();
        }

        const onSearch = () => updateGrid();
        const onChange = () => updateGrid();

        searchInput?.addEventListener('input', onSearch);
        genreFilter?.addEventListener('change', onChange);
        sortFilter?.addEventListener('change', onChange);
        
        // Pre-fill search from URL before initial update (for voice command routing)
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('q') && searchInput) {
            searchInput.value = urlParams.get('q');
        }
        
        // Initial Grid Update
        updateGrid();

        // ── Autoplay Logic for Voice Commands ──
        if (urlParams.get('autoplay') === '1' && tracks.length > 0) {
            // Find the first visible track (first result)
            // Ideally we pick the first one in the DOM since we just updated the grid
            const firstTrack = trackGrid.querySelector('.track-item');
            if (firstTrack) {
                // The main clickable link is the title/image wrapping anchor
                const playBtn = firstTrack.querySelector('a.track-link') || firstTrack.querySelector('a');
                if (playBtn && playBtn.href) {
                     // Small delay to ensure player is ready/page is interactive
                    setTimeout(() => window.location.href = playBtn.href, 500);
                    
                    // Clean URL to avoid re-playing on refresh in background
                    const newUrl = window.location.protocol + "//" + window.location.host + window.location.pathname + '?q=' + urlParams.get('q');
                    window.history.replaceState({path:newUrl},'',newUrl);
                }
            }
        }

        // Like buttons
        const onLike = async (e) => {
            e.preventDefault(); e.stopPropagation();
            const btn = e.currentTarget;
            const icon = btn.querySelector('i');
            const trackId = btn.dataset.id;
            
            icon.classList.toggle('fas'); icon.classList.toggle('far'); icon.classList.toggle('text-red-500');
            try {
                const r = await fetch(`/api/track/${trackId}/like`, { method: 'POST' });
                if (!r.ok) throw new Error();
                
                const data = await r.json();
                
                // Update all like counters for this track ID on the page
                const counters = document.querySelectorAll(`.like-count-${trackId}`);
                counters.forEach(c => {
                    let currentCount = parseInt(c.textContent) || 0;
                    c.textContent = data.liked ? currentCount + 1 : Math.max(0, currentCount - 1);
                });
                
            } catch {
                // Revert on failure
                icon.classList.toggle('fas'); icon.classList.toggle('far'); icon.classList.toggle('text-red-500');
            }
        };

        const likeBtns = document.querySelectorAll('.like-btn');
        likeBtns.forEach(btn => btn.addEventListener('click', onLike));

        // Cleanup function - local scope only
        const cleanup = () => {
            searchInput?.removeEventListener('input', onSearch);
            genreFilter?.removeEventListener('change', onChange);
            sortFilter?.removeEventListener('change', onChange);
            likeBtns.forEach(btn => btn.removeEventListener('click', onLike));
            document.removeEventListener('turbo:before-cache', cleanup);
        };
        document.addEventListener('turbo:before-cache', cleanup, { once: true });
    })();

// ── Discover Canvas (Particle Field + Search Pulse) ────────────────────
// ── Discover Canvas (Particle Field + Search Pulse) ────────────────────
(() => {
    const canvas = document.getElementById('discover-canvas');
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    let W, H, particles = [], pulseRings = [];
    let animationId;
    const cleanup = new AbortController();

    function resizeCanvas() {
        if (!canvas) return;
        W = canvas.width  = window.innerWidth;
        H = canvas.height = window.innerHeight;
    }
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas, { signal: cleanup.signal });

    // Sparse ambient particles
    for (let i = 0; i < 40; i++) {
        particles.push({
            x: Math.random() * window.innerWidth,
            y: Math.random() * window.innerHeight,
            r: Math.random() * 1.5 + 0.5,
            vx: (Math.random() - 0.5) * 0.2,
            vy: (Math.random() - 0.5) * 0.2,
            alpha: Math.random() * 0.4 + 0.1,
        });
    }

    function pulseCanvas() {
        pulseRings.push({ x: W/2, y: 200, r: 0, maxR: 300, alpha: 0.4 });
    }
    // Expose for search input to call
    window.pulseDiscoverCanvas = pulseCanvas;

    // Click ripple anywhere
    document.addEventListener('click', (e) => {
        pulseRings.push({ x: e.clientX, y: e.clientY, r: 0, maxR: 200, alpha: 0.5 });
    }, { signal: cleanup.signal });

    function drawCanvas() {
        if (!ctx) return;
        ctx.clearRect(0, 0, W, H);

        // Ambient particles
        particles.forEach(p => {
            p.x += p.vx; p.y += p.vy;
            if (p.x < 0) p.x = W; if (p.x > W) p.x = 0;
            if (p.y < 0) p.y = H; if (p.y > H) p.y = 0;
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.r, 0, Math.PI*2);
            ctx.fillStyle = `rgba(6,182,212,${p.alpha})`;
            ctx.fill();
        });

        // Pulse rings
        pulseRings = pulseRings.filter(ring => ring.alpha > 0.01);
        pulseRings.forEach(ring => {
            ring.r += 4;
            ring.alpha *= 0.96;
            ctx.beginPath();
            ctx.arc(ring.x, ring.y, ring.r, 0, Math.PI*2);
            ctx.strokeStyle = `rgba(6,182,212,${ring.alpha})`;
            ctx.lineWidth = 1.5;
            ctx.stroke();
        });

        animationId = requestAnimationFrame(drawCanvas);
    }
    drawCanvas();

    // Clean up on Turbo navigation
    document.addEventListener('turbo:before-cache', () => {
        cleanup.abort();
        cancelAnimationFrame(animationId);
        window.pulseDiscoverCanvas = null; // Clean up global
    }, { once: true });
})();
</script>
{% endblock %}
