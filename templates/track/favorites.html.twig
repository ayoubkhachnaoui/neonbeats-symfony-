{% extends 'base.html.twig' %}

{% block title %}My Favorites{% endblock %}

{% block body %}
<div class="min-h-screen bg-black text-white pt-12 text-center pb-24">
    <div class="max-w-7xl mx-auto px-6">
        <div class="flex items-center justify-center space-x-3 mb-8">
            <i class="fas fa-heart text-5xl text-red-500 animate-pulse"></i>
            <h1 class="text-4xl md:text-5xl font-bold font-['Outfit']">Your Favorites</h1>
        </div>

        {% if favorites|length > 0 %}
            <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-6 text-left">
                {% for track in favorites %}
                    {% include 'track/_card.html.twig' with {'track': track, 'context': 'favorite'} %}
                {% endfor %}
            </div>
        {% else %}
            <div class="py-20">
                <div class="inline-block p-6 rounded-full bg-gray-900 border border-gray-800 mb-6">
                    <i class="fas fa-heart-broken text-6xl text-gray-700"></i>
                </div>
                <h2 class="text-2xl font-bold text-gray-300 mb-2">No Favorites Yet</h2>
                <p class="text-gray-500 mb-8">Start listening and click the heart icon to build your collection.</p>
                <a href="{{ path('app_discover') }}" class="inline-flex items-center px-6 py-3 bg-cyan-500 text-black font-bold rounded-full hover:bg-cyan-400 transition-colors shadow-lg shadow-cyan-500/30">
                    <i class="fas fa-compass mr-2"></i> Go to Discover
                </a>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
