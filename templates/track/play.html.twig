{% extends 'base.html.twig' %}

{% block title %}{{ track.title }} - NeonBeats{% endblock %}

{% block body %}
<div class="min-h-screen bg-transparent text-white relative overflow-hidden flex flex-col">
    {# Visualizer Container with Controller #}
    <div id="visualizer-container" class="absolute inset-0 z-0" data-controller="visualizer"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-black/60 z-10 pointer-events-none"></div>

{# Scripts - Minimal for non-critical interactions, or move everything to controllers #}
<script>
    // Legacy interactions (Like, Playlist) can stay for now or be moved.
    // Ideally move to 'track-interactions-controller' but simple script is fine if it doesn't leak.
    // We removed the Visualizer and Global Control logic from here.
    
    document.addEventListener('turbo:load', () => {
         const btnLike = document.getElementById('btn-like');
         if(btnLike) {
             btnLike.addEventListener('click', async () => {
                 const icon = btnLike.querySelector('i');
                 const trackId = btnLike.dataset.id;
                 
                 icon.classList.toggle('fas');
                 icon.classList.toggle('far');
                 icon.classList.toggle('text-red-500');
                 try {
                     const r = await fetch(`/api/track/${trackId}/like`, { method: 'POST' });
                     const data = await r.json();
                     
                     // Update all like counters for this track ID on the page
                     const counters = document.querySelectorAll(`.like-count-${trackId}`);
                     counters.forEach(c => {
                         let currentCount = parseInt(c.textContent) || 0;
                         c.textContent = data.liked ? currentCount + 1 : Math.max(0, currentCount - 1);
                     });
                     
                 } catch(e) {}
             });
         }
         
         // Playlist Popover Logic
           const playlistBtn = document.getElementById('btn-playlist-toggle');
    const playlistPopover = document.getElementById('playlist-popover');

    if (playlistBtn && playlistPopover) {
        playlistBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const isHidden = playlistPopover.classList.contains('hidden');
            
            if (isHidden) {
                playlistPopover.classList.remove('hidden');
                // Small delay for CSS transition
                setTimeout(() => {
                    playlistPopover.classList.remove('scale-95', 'opacity-0');
                    playlistPopover.classList.add('scale-100', 'opacity-100');
                }, 10);
            } else {
                closePopover();
            }
        });

        // Close when clicking outside
        document.addEventListener('click', (e) => {
            if (!playlistPopover.contains(e.target) && e.target !== playlistBtn) {
                closePopover();
            }
        });

        function closePopover() {
            playlistPopover.classList.add('scale-95', 'opacity-0');
            playlistPopover.classList.remove('scale-100', 'opacity-100');
            setTimeout(() => {
                playlistPopover.classList.add('hidden');
            }, 200);
        }
    }

    document.querySelectorAll('.add-to-playlist-btn').forEach(btn => {
        btn.addEventListener('click', async (e) => {
            e.preventDefault();
            e.stopPropagation(); // Prevent closing popover immediately
            
            const playlistId = btn.dataset.playlistId;
            const trackId = btn.dataset.trackId;
            // Visual feedback
            const icon = btn.querySelector('i');
            const originalClass = icon.className;
            
            icon.className = 'fas fa-spinner fa-spin text-cyan-400';

            try {
                const res = await fetch(`/api/playlist/${playlistId}/add-track/${trackId}`, { method: 'POST' });
                if (res.ok) {
                    icon.className = 'fas fa-check text-green-500';
                    setTimeout(() => {
                            if (playlistPopover) closePopover();
                            icon.className = originalClass; 
                    }, 500);
                } else {
                    icon.className = 'fas fa-times text-red-500';
                }
            } catch (err) {
                console.error(err);
                icon.className = 'fas fa-exclamation text-red-500';
            }
        });
    });
    });
</script>


    {# Header #}
    <div class="relative z-20 p-6 flex justify-between items-center">
        <a href="{{ path('app_discover') }}" class="text-white hover:text-cyan-400 transition-colors flex items-center space-x-2">
            <i class="fas fa-arrow-left text-xl"></i>
            <span class="font-medium">Back to Discover</span>
        </a>
        <div class="text-right">
             <h1 class="text-2xl font-bold font-['Outfit'] text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-fuchsia-500">
                NeonBeats Player
            </h1>
        </div>
    </div>

{# Main Player Area - Premium Horizontal Layout #}
    <div class="relative z-20 flex-1 flex items-center justify-center p-6 md:p-12"
         data-controller="full-player"
         data-full-player-track-id-value="{{ track.id }}"
         data-full-player-track-url-value="{{ path('app_track_stream', {'id': track.id}) }}"
         data-full-player-track-title-value="{{ track.title }}"
         data-full-player-track-artist-value="{{ track.artist.artistName ?? track.artist.email }}"
         data-full-player-track-cover-value="{{ track.coverImage }}">
         
        {# Local Audio element for this page ONLY #}
        <audio data-full-player-target="audio" src="{{ path('app_track_stream', {'id': track.id}) }}" crossorigin="anonymous" autoplay="autoplay" class="hidden"></audio>

        <div class="w-full max-w-5xl flex flex-col md:flex-row items-center gap-10 md:gap-16">

            {# ── Left: Album Art ─────────────────────────────────── #}
            <div class="flex-shrink-0 relative">
                {# Outer glow ring - animated #}
                <div class="absolute -inset-4 rounded-full opacity-40 blur-2xl bg-gradient-to-tr from-cyan-500 to-fuchsia-600 animate-pulse pointer-events-none"></div>
                {# Vinyl disc #}
                <div class="w-64 h-64 md:w-80 md:h-80 rounded-full overflow-hidden border-4 border-white/10 shadow-[0_0_60px_rgba(6,182,212,0.25)] relative group" id="album-art-container">
                    {% if track.coverImage %}
                        <img src="{{ asset('uploads/images/' ~ track.coverImage) }}" alt="{{ track.title }}" 
                             class="w-full h-full object-cover animate-[spin_8s_linear_infinite] [animation-play-state:paused]" 
                             id="album-art" 
                             data-full-player-target="albumArt"
                             crossorigin="anonymous">
                    {% else %}
                        <div class="w-full h-full bg-gradient-to-tr from-gray-900 via-gray-800 to-gray-900 flex items-center justify-center animate-[spin_8s_linear_infinite] [animation-play-state:paused]" 
                             id="album-art-placeholder"
                             data-full-player-target="albumArt">
                            <i class="fas fa-music text-6xl text-gray-600"></i>
                        </div>
                    {% endif %}
                    {# Vinyl center #}
                    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-10 h-10 bg-black rounded-full border-2 border-white/20 z-10 flex items-center justify-center">
                        <div class="w-3 h-3 bg-gray-800 rounded-full"></div>
                    </div>
                </div>
            </div>

            {# ── Right: Info + Controls ───────────────────────────── #}
            <div class="flex-1 w-full">
                {# Track Info #}
                <div class="mb-8">
                    <h2 class="text-4xl md:text-5xl font-bold text-white leading-tight mb-2 drop-shadow-[0_0_20px_rgba(255,255,255,0.3)]">{{ track.title }}</h2>
                    <p class="text-xl text-cyan-400 font-medium mb-1">{{ track.artist.artistName ?? track.artist.email }}</p>
                    <div class="flex items-center space-x-3 text-sm text-gray-500">
                        <span class="px-2 py-0.5 rounded-full bg-white/5 border border-white/10">{{ track.category.name ?? 'Uncategorized' }}</span>
                        {% if track.bpm %}<span>{{ track.bpm }} BPM</span>{% endif %}
                        <span class="flex items-center"><i class="fas fa-play mr-1.5 text-xs text-gray-600"></i> <span class="play-count-{{ track.id }}">{{ track.playCount }}</span></span>
                        <span class="flex items-center"><i class="fas fa-heart mr-1.5 text-xs text-gray-600"></i> <span class="like-count-{{ track.id }}">{{ track.likedBy|length }}</span></span>
                    </div>
                </div>

                {# Player Card #}
                <div class="bg-white/5 backdrop-blur-2xl rounded-3xl p-6 border border-white/10 shadow-[0_20px_60px_rgba(0,0,0,0.5)]">
                    
                    {# Progress Bar #}
                    <div class="relative w-full h-5 py-1.5 mb-3 cursor-pointer group select-none" 
                         id="progress-container"
                         data-action="click->full-player#seek">
                        <div class="w-full h-1.5 bg-white/10 rounded-full overflow-hidden">
                            <div class="h-full bg-gradient-to-r from-cyan-500 to-fuchsia-500 rounded-full w-0 transition-all duration-75" 
                                 id="progress-bar"
                                 data-full-player-target="progress"></div>
                        </div>
                        <div class="absolute top-1/2 -translate-y-1/2 -ml-2 w-4 h-4 bg-white rounded-full shadow-[0_0_10px_rgba(255,255,255,0.8)] opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none" 
                             id="progress-handle" 
                             data-full-player-target="progressHandle"
                             style="left: 0%"></div>
                    </div>

                    {# Time #}
                    <div class="flex justify-between text-xs text-gray-500 font-mono mb-6">
                        <span id="current-time" data-full-player-target="currentTime">0:00</span>
                        <span id="total-duration" data-full-player-target="duration">--:--</span>
                    </div>

                    {# Main Controls #}
                    <div class="flex items-center justify-between mb-6">
                        <button class="text-gray-500 hover:text-fuchsia-400 transition-colors p-2" id="btn-shuffle" title="Shuffle">
                            <i class="fas fa-random text-lg"></i>
                        </button>

                        <div class="flex items-center space-x-5">
                            {% if prevTrack %}
                                <a href="{{ path('app_track_play', {'id': prevTrack.id}) }}" class="text-gray-400 hover:text-white transition-colors p-2" id="btn-prev">
                                    <i class="fas fa-step-backward text-xl"></i>
                                </a>
                            {% else %}
                                <button class="text-gray-700 cursor-not-allowed p-2" disabled><i class="fas fa-step-backward text-xl"></i></button>
                            {% endif %}

                            {# Play/Pause Button - Premium #}
                            <button class="w-16 h-16 rounded-full flex items-center justify-center transition-all shadow-[0_0_30px_rgba(6,182,212,0.4)] hover:shadow-[0_0_50px_rgba(6,182,212,0.7)] active:scale-95 bg-gradient-to-tr from-cyan-500 to-fuchsia-600 text-white" 
                                    id="btn-play-pause"
                                    data-full-player-target="playBtn"
                                    data-action="full-player#toggle">
                                <i class="fas fa-play text-xl ml-1"></i>
                            </button>

                            {% if nextTrack %}
                                <a href="{{ path('app_track_play', {'id': nextTrack.id}) }}" class="text-gray-400 hover:text-white transition-colors p-2" id="btn-next">
                                    <i class="fas fa-step-forward text-xl"></i>
                                </a>
                            {% else %}
                                <button class="text-gray-700 cursor-not-allowed p-2" disabled><i class="fas fa-step-forward text-xl"></i></button>
                            {% endif %}
                        </div>

                        <button class="text-gray-500 hover:text-fuchsia-400 transition-colors p-2" id="btn-repeat" title="Repeat" data-action="full-player#toggleLoop">
                            <i class="fas fa-redo text-lg"></i>
                        </button>
                    </div>

                    {# Secondary Controls #}
                    <div class="flex items-center justify-center space-x-6 pt-4 border-t border-white/5">
                        <button class="text-gray-500 hover:text-red-500 transition-colors flex items-center space-x-1.5" id="btn-like" data-id="{{ track.id }}" title="Like">
                            <i class="{{ app.user and app.user.favoriteTracks.contains(track) ? 'fas text-red-500' : 'far' }} fa-heart text-lg"></i>
                        </button>

                        <div class="relative">
                            <button class="text-gray-500 hover:text-cyan-400 transition-colors flex items-center space-x-1.5" id="btn-playlist-toggle" title="Add to Playlist">
                                <i class="fas fa-plus-circle text-lg"></i>
                            </button>
                            <div id="playlist-popover" class="absolute bottom-full left-1/2 -translate-x-1/2 mb-4 w-64 bg-[#1a1a1a] border border-[#333] rounded-xl shadow-2xl p-2 hidden z-50">
                                <div class="text-xs font-bold text-gray-500 uppercase tracking-wider mb-2 px-2 pb-2 border-b border-[#333]">Add to Playlist</div>
                                <div class="max-h-48 overflow-y-auto space-y-1">
                                    {% if app.user and app.user.playlists|length > 0 %}
                                        {% for pl in app.user.playlists %}
                                            <button class="w-full text-left px-3 py-2 rounded-lg hover:bg-[#333] text-sm text-gray-300 hover:text-white flex items-center justify-between group add-to-playlist-btn"
                                                    data-playlist-id="{{ pl.id }}" data-track-id="{{ track.id }}">
                                                <span class="truncate">{{ pl.name }}</span>
                                                <i class="fas fa-plus text-xs opacity-0 group-hover:opacity-100 text-cyan-400"></i>
                                            </button>
                                        {% endfor %}
                                    {% else %}
                                        <div class="px-3 py-4 text-center">
                                            <p class="text-xs text-gray-500 mb-2">No playlists yet</p>
                                            <a href="{{ path('app_playlist_index') }}" class="text-xs text-cyan-400 hover:underline">Create One</a>
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Recommendations #}
    {% if recommendations|length > 0 %}
        <div class="relative z-20 w-full max-w-7xl mx-auto px-6 py-8">
            <h3 class="text-xl font-bold mb-4 text-gray-300">Up Next</h3>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4" id="recommendations-list">
                {% for rec in recommendations %}
                    <a href="{{ path('app_track_play', {'id': rec.id}) }}" class="bg-gray-900/50 p-3 rounded-xl hover:bg-gray-800/80 transition-all flex items-center space-x-3 group recommendation-link" data-id="{{ rec.id }}">
                         <div class="w-12 h-12 rounded-lg overflow-hidden flex-shrink-0 relative">
                            {% if rec.coverImage %}
                                <img src="{{ asset('uploads/images/' ~ rec.coverImage) }}" class="w-full h-full object-cover">
                            {% else %}
                                <div class="w-full h-full bg-gray-700"></div>
                            {% endif %}
                            <div class="absolute inset-0 bg-black/40 hidden group-hover:flex items-center justify-center">
                                <i class="fas fa-play text-white text-xs"></i>
                            </div>
                        </div>
                        <div class="min-w-0">
                            <h4 class="text-sm font-bold truncate text-gray-200 group-hover:text-cyan-400">{{ rec.title }}</h4>
                            <p class="text-xs text-gray-500 truncate">{{ rec.artist.artistName }}</p>
                        </div>
                    </a>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {# NeonVoice AI Assistant - Local to Play Page ONLY #}
    {% include 'components/voice_assistant.html.twig' %}
</div>


{% endblock %}
