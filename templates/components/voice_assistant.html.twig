{# ══════════════════════════════════════════════════════════════════
   NeonVoice — Enhanced Corner Widget
   Contains:
   - Status Indicator
   - Manual Activation
   - Settings: Auto-listen, Voice Cues, Mic Selection
══════════════════════════════════════════════════════════════════ #}

{# ── Corner Widget ──────────────────────────────────────────────── #}
<div id="nv-widget"
     class="fixed bottom-28 right-6 z-[200] w-64 rounded-2xl overflow-hidden shadow-[0_8px_32px_rgba(0,0,0,0.6)] border border-white/[0.08] transition-all duration-300"
     style="background: rgba(10,10,18,0.9); backdrop-filter: blur(20px);">

    {# Header bar #}
    <div class="flex items-center justify-between px-4 py-3 border-b border-white/[0.06] bg-white/[0.02]">
        <div class="flex items-center space-x-2.5">
            {# Live dot #}
            <span id="nv-live-dot" class="relative flex h-2 w-2">
                <span class="nv-dot-ping animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-0"></span>
                <span id="nv-dot-core" class="relative inline-flex rounded-full h-2 w-2 bg-gray-600 transition-colors duration-300"></span>
            </span>
            <span class="text-xs font-bold tracking-widest text-white uppercase font-['Outfit']">NeonVoice</span>
        </div>
        {# Collapse toggle #}
        <button id="nv-collapse-btn" onclick="nvToggleCollapse()"
                class="text-gray-500 hover:text-white transition-colors p-1 rounded hover:bg-white/5">
            <i class="fas fa-chevron-down text-[10px]" id="nv-chevron"></i>
        </button>
    </div>

    {# Body (collapsible) #}
    <div id="nv-body" class="transition-all duration-300 origin-bottom">
        
        {# Notification Area (Toasts) #}
        <div id="nv-toast-container" class="px-4 pt-4 pb-0 hidden">
            <div id="nv-toast" class="text-[10px] px-3 py-2 rounded bg-cyan-500/10 border border-cyan-500/20 text-cyan-300 text-center animate-fade-in"></div>
        </div>

        {# Main Controls #}
        <div class="px-4 py-4 space-y-4">
            
            {# Status Text #}
            <div class="text-center">
                <p id="nv-status-widget" class="text-[11px] font-medium text-gray-400 min-h-[16px]">Ready</p>
            </div>

            {# Activate Button #}
            <button id="nv-manual-btn"
                    onclick="NeonVoice.activate()"
                    class="w-full flex items-center justify-center space-x-2 py-2.5 rounded-xl bg-gradient-to-r from-cyan-500/20 to-fuchsia-600/20 border border-cyan-500/30 hover:border-cyan-400/60 hover:bg-cyan-500/15 transition-all group active:scale-95 shadow-[0_0_15px_rgba(6,182,212,0.1)]">
                <i class="fas fa-microphone text-cyan-400 text-sm group-hover:text-cyan-300 transition-colors nv-mic-icon"></i>
                <span class="text-xs font-semibold text-cyan-400 group-hover:text-cyan-300 transition-colors">Activate Now</span>
            </button>
        </div>

        {# Settings Section #}
        <div class="bg-black/20 px-4 py-3 border-t border-white/[0.06] space-y-3">
            
            {# Toggles Grid #}
            <div class="grid grid-cols-2 gap-2">
                
                {# Auto-Listen Toggle #}
                <div class="flex flex-col space-y-1.5 p-2 rounded bg-white/[0.03] border border-white/[0.02]">
                    <span class="text-[10px] text-gray-400 font-medium">Auto-Listen</span>
                    <button id="nv-auto-toggle"
                            onclick="NeonVoice.toggleSetting('autoListen')"
                            class="relative w-8 h-4 rounded-full transition-all duration-300 bg-gray-700 self-start"
                            role="switch" aria-checked="false">
                        <span class="nv-thumb absolute top-0.5 left-0.5 w-3 h-3 rounded-full bg-gray-400 shadow transition-all duration-300"></span>
                    </button>
                </div>

                {# Voice Cues Toggle #}
                <div class="flex flex-col space-y-1.5 p-2 rounded bg-white/[0.03] border border-white/[0.02]">
                    <span class="text-[10px] text-gray-400 font-medium">Voice Cues</span>
                    <button id="nv-cues-toggle"
                            onclick="NeonVoice.toggleSetting('voiceCues')"
                            class="relative w-8 h-4 rounded-full transition-all duration-300 bg-gray-700 self-start"
                            role="switch" aria-checked="false">
                        <span class="nv-thumb absolute top-0.5 left-0.5 w-3 h-3 rounded-full bg-gray-400 shadow transition-all duration-300"></span>
                    </button>
                </div>
            </div>

            {# Mic Selection #}
            <div class="space-y-1.5 pt-1">
                <div class="flex justify-between items-center">
                    <label for="nv-mic-select" class="text-[10px] text-gray-400 font-medium ml-1">Microphone</label>
                    <button onclick="NeonVoice.refreshDevices()" class="text-[10px] text-cyan-500 hover:text-cyan-400" title="Refresh Devices">
                        <i class="fas fa-sync-alt"></i>
                    </button>
                </div>
                <div class="relative">
                    <select id="nv-mic-select" onchange="NeonVoice.setMicDevice(this.value)"
                            class="w-full text-[10px] bg-black/40 border border-white/10 rounded text-gray-300 py-1.5 pl-2 pr-6 focus:outline-none focus:border-cyan-500/50 appearance-none truncate">
                        <option value="">Default Device</option>
                    </select>
                    <i class="fas fa-caret-down absolute right-2 top-1/2 -translate-y-1/2 text-gray-500 text-[10px] pointer-events-none"></i>
                </div>
            </div>

            {# Customization #}
            <div class="grid grid-cols-2 gap-2 pt-1 border-t border-white/[0.04] mt-2">
                <div class="space-y-1">
                     <label for="nv-wake-word" class="text-[10px] text-gray-400 font-medium ml-1">Wake Word</label>
                     <input type="text" id="nv-wake-word" 
                            onchange="NeonVoice.setWakeWord(this.value)"
                            placeholder="NeonBeats"
                            class="w-full text-[10px] bg-black/40 border border-white/10 rounded text-gray-300 py-1.5 px-2 focus:outline-none focus:border-cyan-500/50">
                </div>
                <div class="space-y-1">
                     <label for="nv-voice-gender" class="text-[10px] text-gray-400 font-medium ml-1">Voice Gender</label>
                     <div class="relative">
                        <select id="nv-voice-gender" onchange="NeonVoice.setVoiceGender(this.value)"
                                class="w-full text-[10px] bg-black/40 border border-white/10 rounded text-gray-300 py-1.5 pl-2 pr-6 focus:outline-none focus:border-cyan-500/50 appearance-none">
                            <option value="female">Female</option>
                            <option value="male">Male</option>
                        </select>
                        <i class="fas fa-caret-down absolute right-2 top-1/2 -translate-y-1/2 text-gray-500 text-[10px] pointer-events-none"></i>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

{# ══════════════════════════════════════════════════════════════════
   FULL-SCREEN ACTIVATION OVERLAY
══════════════════════════════════════════════════════════════════ #}
<div id="nv-overlay"
     class="fixed inset-0 z-[9999] flex flex-col items-center justify-center pointer-events-none opacity-0 transition-all duration-500"
     aria-live="polite">

    <div class="absolute inset-0 bg-black/80 backdrop-blur-md nv-backdrop"></div>

    <button class="absolute top-6 right-6 text-gray-500 hover:text-white transition-colors z-10 pointer-events-auto p-2"
            onclick="NeonVoice.deactivate()">
        <i class="fas fa-times text-2xl"></i>
    </button>

    {# Orb #}
    <div id="nv-orb" class="relative w-64 h-64 flex items-center justify-center">
        <div class="nv-blob nv-blob-1"></div>
        <div class="nv-blob nv-blob-2"></div>
        <div class="nv-blob nv-blob-3"></div>
        <div class="absolute inset-0 rounded-full border border-cyan-500/20 nv-ring-outer"></div>
        <div class="absolute inset-8 rounded-full border border-fuchsia-500/20 nv-ring-inner"></div>
        <div class="absolute w-24 h-24 rounded-full bg-gradient-to-tr from-cyan-500 to-fuchsia-600 flex items-center justify-center z-10 shadow-[0_0_50px_rgba(6,182,212,0.5)]">
            <i class="fas fa-microphone text-white text-3xl nv-mic-icon"></i>
        </div>
    </div>

    <div class="relative z-10 mt-8 text-center space-y-3">
        <p id="nv-status" class="text-white text-2xl font-bold font-['Outfit'] tracking-wide drop-shadow-lg"></p>
        <p id="nv-transcript" class="text-cyan-300 text-base opacity-90 italic max-w-md px-4 leading-relaxed"></p>
    </div>

    <div class="relative z-10 mt-8 flex flex-wrap gap-2 justify-center max-w-md px-4">
        {% for hint in ['Play','Pause','Next','Previous','Shuffle','Loop','Search...','Volume Up','Volume Down'] %}
            <span class="px-3 py-1.5 bg-white/5 border border-white/10 rounded-full text-xs text-gray-400 backdrop-blur-sm hover:bg-white/10 transition-colors cursor-help">{{ hint }}</span>
        {% endfor %}
    </div>
</div>

{# ── Styles ──────────────────────────────────────────────────────── #}
<style>
/* Overlay states */
#nv-overlay.nv-visible { opacity: 1; pointer-events: all; }
#nv-overlay .nv-backdrop { opacity: 0; transition: opacity 0.5s ease; }
#nv-overlay.nv-visible .nv-backdrop { opacity: 1; }

/* Toggles Active State */
button[role="switch"].nv-on {
    background: linear-gradient(to right, #06b6d4, #a855f7);
}
button[role="switch"].nv-on .nv-thumb {
    transform: translateX(16px); /* 32px width - 16px offset approx */
    background: white;
}

/* Live dot active */
#nv-widget.nv-listening #nv-dot-core { background: #4ade80; }
#nv-widget.nv-listening .nv-dot-ping { opacity: 0.75; }

/* Widget manual btn active */
#nv-manual-btn.nv-active {
    border-color: rgba(6,182,212,0.8);
    background: rgba(6,182,212,0.2);
    animation: btnPulse 1s ease-in-out infinite;
}
@keyframes btnPulse {
    0%,100% { box-shadow: 0 0 0 0 rgba(6,182,212,0.4); }
    50%      { box-shadow: 0 0 0 8px rgba(6,182,212,0); }
}

/* Mic pulse */
#nv-overlay.nv-active .nv-mic-icon { animation: micPulse 0.8s ease-in-out infinite; }
@keyframes micPulse {
    0%,100% { opacity: 1; transform: scale(1); }
    50%     { opacity: 0.5; transform: scale(0.85); }
}

/* Orb blobs */
.nv-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(50px);
    opacity: 0;
    transition: opacity 0.5s ease;
    animation: blobFloat 4s ease-in-out infinite;
}
#nv-overlay.nv-visible .nv-blob { opacity: 0.8; }

.nv-blob-1 { width:160px;height:160px; background:radial-gradient(circle,#06b6d4,#0e7490); top:0;left:10%; animation-delay:0s; }
.nv-blob-2 { width:130px;height:130px; background:radial-gradient(circle,#d946ef,#7e22ce); bottom:0;right:10%; animation-delay:-1.5s; }
.nv-blob-3 { width:100px;height:100px; background:radial-gradient(circle,#3b82f6,#1d4ed8); top:40%;left:40%; animation-delay:-3s; }

#nv-overlay.nv-processing .nv-blob { animation-duration:0.6s; }
#nv-overlay.nv-processing .nv-blob-1 { background:radial-gradient(circle,#f59e0b,#d97706); } /* Amber for processing */

.nv-ring-outer { animation: ringRotate 10s linear infinite; }
.nv-ring-inner { animation: ringRotate 6s linear infinite reverse; }
@keyframes ringRotate { from{transform:rotate(0deg)} to{transform:rotate(360deg)} }
@keyframes blobFloat { 
    0%,100%{transform:translate(0,0) scale(1)} 
    33%{transform:translate(20px,-20px) scale(1.1)} 
    66%{transform:translate(-15px,15px) scale(0.9)} 
}

/* Collapse */
#nv-body.nv-collapsed { display: none; }
#nv-chevron.nv-up { transform: rotate(180deg); }

/* Toast Animation */
@keyframes fadeIn {
    from { opacity: 0; transform: translateY(5px); }
    to { opacity: 1; transform: translateY(0); }
}
.animate-fade-in { animation: fadeIn 0.3s ease-out forwards; }
</style>

{# ── Widget JS Helpers (Toggle UI) ───────────────────────────────── #}
<script>
function nvToggleCollapse() {
    const body    = document.getElementById('nv-body');
    const chevron = document.getElementById('nv-chevron');
    body?.classList.toggle('nv-collapsed');
    chevron?.classList.toggle('nv-up');
}
</script>
