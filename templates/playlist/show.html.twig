{% extends 'base.html.twig' %}

{% block title %}{{ playlist.name }} - NeonBeats{% endblock %}

{% block body %}
<div class="min-h-screen bg-black text-white pb-24">
    <div class="flex h-screen overflow-hidden">
        {# Include Sidebar (Copied from discover.html.twig structure, ideally this should be in base or include) #}
        {# Ideally we should move navigation to a partial, but for now assuming base or consistent layout #}
        {# WE WILL RELY ON BASE.HTML.TWIG HAVING THE SIDEBAR OR JUST SHOW CONTENT assuming base handles it #}
        {# Wait, discover.html.twig had the sidebar INCLUDED in it, replacing base layout. 
           Let's assume we want a consistent layout. The user asked for "like Spotify".
           We should probably refactor sidebar to base.html.twig soon. For now, I will include a link back. #}

        <div class="flex-1 overflow-y-auto bg-gradient-to-br from-gray-900 to-black p-8 relative">
             <a href="{{ path('app_discover') }}" class="absolute top-8 left-8 text-gray-400 hover:text-white flex items-center mb-8">
                <i class="fas fa-arrow-left mr-2"></i> Back
             </a>

             <div class="mt-16 flex items-start space-x-8 mb-12">
                 <div class="w-52 h-52 bg-gradient-to-br from-cyan-500 to-blue-600 rounded-lg shadow-[0_0_50px_rgba(34,211,238,0.3)] flex items-center justify-center">
                     <i class="fas fa-list-ul text-6xl text-black"></i>
                 </div>
                 <div>
                     <p class="text-sm font-bold uppercase tracking-wider text-gray-400 mb-2">Playlist</p>
                     <h1 class="text-5xl md:text-7xl font-bold font-['Outfit'] mb-6">{{ playlist.name }}</h1>
                     <p class="text-gray-400">Created by <span class="text-white">{{ playlist.user.email }}</span> • {{ playlist.tracks|length }} songs</p>
                 </div>
             </div>

             {# Track List #}
             <div class="space-y-2">
                 <div class="flex items-center text-gray-500 text-sm border-b border-gray-800 pb-2 mb-4 px-4">
                     <div class="w-12">#</div>
                     <div class="flex-1">Title</div>
                     <div class="w-1/4">Genre</div>
                     <div class="w-24 text-right"><i class="far fa-clock"></i></div>
                     <div class="w-12"></div>
                 </div>

                 {% for track in playlist.tracks %}
                     <div class="group flex items-center hover:bg-white/10 rounded-lg p-2 px-4 transition-colors cursor-pointer" onclick="window.location='{{ path('app_track_play', {'id': track.id}) }}'">
                         <div class="w-12 text-gray-500 group-hover:text-white">{{ loop.index }}</div>
                         <div class="flex-1 flex items-center space-x-4">
                             {% if track.coverImage %}
                                 <img src="{{ asset('uploads/images/' ~ track.coverImage) }}" class="w-10 h-10 rounded object-cover">
                             {% else %}
                                 <div class="w-10 h-10 bg-gray-800 rounded flex items-center justify-center"><i class="fas fa-music text-gray-500"></i></div>
                             {% endif %}
                             <div>
                                 <div class="font-bold text-white group-hover:text-cyan-400">{{ track.title }}</div>
                                 <div class="text-sm text-gray-400">{{ track.artist.artistName }}</div>
                             </div>
                         </div>
                         <div class="w-1/4 text-gray-400 text-sm">{{ track.category.name|default('-') }}</div>
                         <div class="w-24 text-right text-gray-500 text-sm">
                             {% if track.duration %}
                                 {{ (track.duration / 60)|round(0, 'floor') }}:{{ '%02d'|format(track.duration % 60) }}
                             {% else %}
                                 --:--
                             {% endif %}
                         </div>
                         <div class="w-12 flex justify-end">
                             <button class="text-gray-500 hover:text-red-500 delete-from-playlist" data-id="{{ track.id }}" title="Remove">
                                 <i class="fas fa-trash"></i>
                             </button>
                         </div>
                     </div>
                 {% else %}
                     <div class="text-center py-12 text-gray-500">
                         <p>This playlist is empty.</p>
                         <a href="{{ path('app_discover') }}" class="text-cyan-400 hover:underline">Find songs to add</a>
                     </div>
                 {% endfor %}
             </div>
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('.delete-from-playlist').forEach(btn => {
        btn.addEventListener('click', async (e) => {
            e.stopPropagation();
            if(!confirm('Remove this track from playlist?')) return;
            
            const trackId = btn.dataset.id;
            const playlistId = '{{ playlist.id }}'; // Assuming context
            
            try {
                const res = await fetch(`/api/playlist/${playlistId}/remove-track/${trackId}`, { method: 'DELETE' });
                if(res.ok) window.location.reload();
            } catch(e) { console.error(e); }
        });
    });
</script>
{% endblock %}
