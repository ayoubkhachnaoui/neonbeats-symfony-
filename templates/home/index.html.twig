{% extends 'base.html.twig' %}

{% block title %}NeonBeats — Future of Music{% endblock %}

{% block body %}
<div class="relative w-full h-screen overflow-hidden bg-transparent">
    {# Overlay gradient #}
    <div class="absolute inset-0 z-[1] bg-gradient-to-t from-black via-black/30 to-transparent pointer-events-none"></div>

    {# Floating music note particles (CSS) #}
    <div class="absolute inset-0 z-[2] pointer-events-none overflow-hidden" id="note-particles">
        {% for i in 1..8 %}
            <span class="note-particle absolute text-2xl opacity-0"
                  style="left: {{ (i * 11 + 5) }}%; animation-delay: {{ i * 0.7 }}s; animation-duration: {{ 6 + i }}s;">
                {{ random(['♪','♫','♩','♬']) }}

            </span>
        {% endfor %}
    </div>

    {# Hero Content #}
    <div class="relative z-10 flex flex-col items-center justify-center w-full h-full text-center px-6">
        <div class="mb-4">
            <span class="text-xs font-semibold tracking-[0.4em] text-cyan-500 uppercase">Welcome to</span>
        </div>
        <h1 class="text-7xl md:text-8xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-400 to-fuchsia-500 font-['Outfit'] mb-6 drop-shadow-[0_0_30px_rgba(34,211,238,0.4)] leading-none">
            NeonBeats
        </h1>
        <p class="text-xl text-gray-400 mb-10 max-w-lg leading-relaxed">
            Experience music in a new dimension.<br>
            <span class="text-gray-500 text-base">Stream high-fidelity tracks in a reactive 3D environment.</span>
        </p>

        <div class="flex flex-col sm:flex-row items-center gap-4">
            <a href="{{ path('app_discover') }}"
               class="px-10 py-4 font-bold text-black bg-gradient-to-r from-cyan-400 to-cyan-500 rounded-full hover:shadow-[0_0_30px_rgba(34,211,238,0.6)] hover:scale-105 transition-all active:scale-95 text-lg">
                <i class="fas fa-headphones mr-2"></i>Start Listening
            </a>
            <a href="{{ path('app_register') }}"
               class="px-10 py-4 font-bold text-white border border-fuchsia-500/60 rounded-full hover:bg-fuchsia-500/15 hover:border-fuchsia-400 hover:shadow-[0_0_25px_rgba(217,70,239,0.4)] hover:scale-105 transition-all active:scale-95 text-lg">
                <i class="fas fa-microphone mr-2"></i>Join as Artist
            </a>
        </div>

        {# Quick Playlist CTA for logged-in users #}
        {% if app.user %}
        <div class="mt-10 flex items-center space-x-3 px-6 py-3 rounded-2xl bg-white/5 border border-white/10 backdrop-blur-xl">
            <i class="fas fa-list-music text-fuchsia-400"></i>
            <span class="text-gray-400 text-sm">Ready to curate?</span>
            <a href="{{ path('app_playlist_index') }}" class="text-cyan-400 text-sm font-semibold hover:text-cyan-300 transition-colors">
                Create a Playlist →
            </a>
        </div>
        {% endif %}

        {# Scroll hint #}
        <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center space-y-2 animate-bounce opacity-40">
            <span class="text-xs text-gray-500 tracking-widest uppercase">Explore</span>
            <i class="fas fa-chevron-down text-gray-500"></i>
        </div>
    </div>
</div>

<style>
@keyframes floatNote {
    0%   { opacity: 0; transform: translateY(100vh) rotate(0deg); }
    10%  { opacity: 0.3; }
    90%  { opacity: 0.15; }
    100% { opacity: 0; transform: translateY(-20vh) rotate(360deg); }
}
.note-particle {
    animation: floatNote linear infinite;
    color: rgba(6,182,212,0.5);
    font-size: 1.5rem;
}
</style>
{% endblock %}
