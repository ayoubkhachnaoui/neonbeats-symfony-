<!DOCTYPE html>
<html lang="en" class="dark">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}NeonBeats{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🎵</text></svg>">
        
        {# Run `composer require symfony/webpack-encore-bundle` to start using Encore #}
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
        
        {# Preconnect hints — warms up CDN DNS before the browser parses the links below #}
        <link rel="preconnect" href="https://cdnjs.cloudflare.com">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

        {# Font Awesome #}
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
              integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
              crossorigin="anonymous" referrerpolicy="no-referrer">

        {# Google Fonts — display=swap prevents FOIT (invisible text while font loads) #}
        <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
    </head>
    <body class="bg-[#0f0f0f] text-white font-['Outfit'] antialiased selection:bg-cyan-500 selection:text-black">
        {# 3D Background Container (Persistent across Turbo navigation) #}
        <div id="canvas-container" class="fixed inset-0 z-0 pointer-events-none" data-turbo-permanent></div>
        
        <div class="min-h-screen flex flex-col bg-[#0f0f0f]">
            <nav class="sticky top-0 z-50 border-b border-white/5" id="main-nav">
                <div class="absolute inset-0 bg-black/70 backdrop-blur-xl"></div>
                <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="flex items-center justify-between h-16">
                        {# Logo #}
                        <a href="{{ path('app_home') }}" class="flex items-center space-x-2 group">
                            <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-cyan-500 to-fuchsia-600 flex items-center justify-center shadow-[0_0_12px_rgba(6,182,212,0.5)] group-hover:shadow-[0_0_20px_rgba(6,182,212,0.8)] transition-all">
                                <i class="fas fa-music text-white text-sm"></i>
                            </div>
                            <span class="text-xl font-bold font-['Outfit'] text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-400 to-fuchsia-500 tracking-tight">
                                NeonBeats
                            </span>
                        </a>

                        {# Center Nav Links #}
                        <div class="hidden md:flex items-center space-x-1">
                            <a href="{{ path('app_discover') }}" class="nav-link px-4 py-1.5 rounded-full text-sm font-medium text-gray-400 hover:text-white hover:bg-white/10 transition-all">
                                <i class="fas fa-compass mr-1.5 text-xs"></i>Discover
                            </a>
                            {% if app.user %}
                                <a href="{{ path('app_playlist_index') }}" class="nav-link px-4 py-1.5 rounded-full text-sm font-medium text-gray-400 hover:text-white hover:bg-white/10 transition-all">
                                    <i class="fas fa-list-music mr-1.5 text-xs"></i>Playlists
                                </a>
                            {% endif %}
                            {% if is_granted('ROLE_ARTIST') %}
                                <a href="{{ path('app_track_new') }}" class="nav-link px-4 py-1.5 rounded-full text-sm font-medium text-gray-400 hover:text-white hover:bg-white/10 transition-all">
                                    <i class="fas fa-sliders-h mr-1.5 text-xs"></i>Studio
                                </a>
                            {% endif %}
                            {% if is_granted('ROLE_ADMIN') %}
                                <a href="{{ path('admin_dashboard') }}" class="nav-link px-4 py-1.5 rounded-full text-sm font-bold text-red-400 hover:text-red-300 hover:bg-red-500/10 transition-all">
                                    <i class="fas fa-shield-alt mr-1.5 text-xs"></i>Admin
                                </a>
                            {% endif %}
                        </div>

                        {# Right Side #}
                        <div class="hidden md:flex items-center space-x-3">
                            {% if app.user %}
                                <div class="flex items-center space-x-2 px-3 py-1.5 rounded-full bg-white/5 border border-white/10">
                                    <div class="w-6 h-6 rounded-full bg-gradient-to-tr from-cyan-500 to-fuchsia-600 flex items-center justify-center text-xs font-bold text-white">
                                        {{ (app.user.artistName ?? app.user.email)|first|upper }}
                                    </div>
                                    <span class="text-gray-300 text-sm">{{ app.user.artistName ?? app.user.email|split('@')[0] }}</span>
                                </div>
                                <a href="{{ path('app_logout') }}" class="px-4 py-1.5 rounded-full text-sm font-medium text-gray-400 hover:text-white hover:bg-white/10 transition-all border border-white/10">
                                    Logout
                                </a>
                            {% else %}
                                <a href="{{ path('app_login') }}" class="px-4 py-1.5 rounded-full text-sm font-medium text-gray-300 hover:text-white hover:bg-white/10 transition-all">
                                    Sign In
                                </a>
                                <a href="{{ path('app_register') }}" class="px-4 py-1.5 rounded-full text-sm font-semibold bg-gradient-to-r from-cyan-500 to-fuchsia-600 text-white hover:opacity-90 transition-all shadow-[0_0_15px_rgba(6,182,212,0.3)] hover:shadow-[0_0_25px_rgba(6,182,212,0.5)]">
                                    Get Started
                                </a>
                            {% endif %}
                        </div>

                    </div>
                </div>
            </nav>

            <main class="flex-grow" id="page-main" style="animation: pageFadeIn 0.4s ease-out both;">
                {% block body %}{% endblock %}
            </main>
        </div>


        <style>
        @keyframes pageFadeIn {
            from { opacity: 0; transform: translateY(12px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        </style>
    </body>
</html>
